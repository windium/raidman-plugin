<script>
document.addEventListener('DOMContentLoaded', function() {
    updateAnchorText();
    toggleKeyList(); // Ensure initial state is correct
    
    // Add event listener to all checkboxes
    var checkboxes = document.querySelectorAll('#list1 input[type="checkbox"]');
    checkboxes.forEach(function(checkbox) {
        checkbox.addEventListener('change', updateAnchorText);
    });
});

function updateAnchorText() {
    var checkboxes = document.querySelectorAll('#list1 input[type="checkbox"]');
    var selected = [];
    checkboxes.forEach(function(checkbox) {
        if (checkbox.checked) {
            // Get the label text which is the next sibling
            var label = checkbox.nextSibling.textContent.trim();
            if (label) selected.push(label);
        }
    });
    
    var anchor = document.querySelector('#list1 .anchor');
    anchor.value = selected.join(', ');
}

function toggleDropdown() {
    var checkList = document.getElementById('list1');
    if (checkList.classList.contains('visible'))
        checkList.classList.remove('visible');
    else
        checkList.classList.add('visible');
}

// Close dropdown when clicking outside
document.addEventListener('click', function(e) {
    var checkList = document.getElementById('list1');
    if (checkList && !checkList.contains(e.target) && e.target.className !== 'anchor') {
        checkList.classList.remove('visible');
    }
});

function toggleKeyList() {
    var select = document.getElementById('restrict_api_keys');
    var list1 = document.getElementById('list1');
    if (!list1) return;
    
    // In Unraid settings pages, the structure is usually dl > dt, dd.
    // list1 is inside the dd. The dt is the previous sibling of the dd.
    var dd = list1.closest('dd');
    var dt = dd ? dd.previousElementSibling : null;
    
    if (dd && dt) {
        var display = (select.value === "true") ? '' : 'none';
        dd.style.display = display;
        dt.style.display = display;
    }
}
</script>
