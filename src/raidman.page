<div id="api_key_section" style="display: <?= $settings['restrict_api_keys'] ? 'block' : 'none' ?>;">
Allowed API Keys:
: <div id="list1" class="dropdown-check-list" tabindex="100">
    <span class="anchor" onclick="toggleDropdown()">Select API Keys</span>
    <ul class="items">
        <?php foreach ($available_keys as $key => $name): ?>
        <li><input type="checkbox" name="allowed_api_keys[]" value="<?= $key ?>" <?= in_array($key, $settings['allowed_api_keys']) ? 'checked' : '' ?> /> <?= htmlspecialchars($name) ?> </li>
        <?php endforeach; ?>
    </ul>
  </div>
  <br>_Select the API keys that are allowed to access the plugin._
</div>

<br>
<input type="submit" value="Apply">

</form>

<script>
function toggleDropdown() {
    var checkList = document.getElementById('list1');
    if (checkList.classList.contains('visible'))
        checkList.classList.remove('visible');
    else
        checkList.classList.add('visible');
}

// Close dropdown when clicking outside
document.addEventListener('click', function(e) {
    var checkList = document.getElementById('list1');
    if (!checkList.contains(e.target)) {
        checkList.classList.remove('visible');
    }
});

function toggleKeyList() {
    var select = document.getElementById('restrict_api_keys');
    var section = document.getElementById('api_key_section');
    section.style.display = (select.value === "true") ? 'block' : 'none';
}
</script>
